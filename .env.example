# Copy this file to .env and replace every CHANGEME. .env is never committed.
# Generate each secret with:  openssl rand -hex 32
#
# Both `docker compose` and the Python program read the .env file.

# --- Python program: the model and the agent ------------------------------
# Every setting in src/ai_playground/config.py can be set here, in capitals.
# These are the defaults; uncomment a line to change it.

# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=google/gemma-4-e4b
# LLM_API_KEY=not-needed-for-local-servers
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2
# AGENT_MAX_TURNS=10

# --- Python program: where to send traces ----------------------------------

# Langfuse API keys. Leave these out to send traces to Phoenix only.
# Locally, Langfuse creates a project with these keys on first start (see the
# LANGFUSE_INIT_PROJECT_* lines below), so they must match.
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-CHANGEME
LANGFUSE_HOST=http://localhost:3000

# Optional: a Phoenix server other than http://localhost:6006
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# --- Langfuse in Docker: first-start setup ---------------------------------

# Created automatically the first time Langfuse starts. Log in with these.
LANGFUSE_INIT_ORG_ID=local-org
LANGFUSE_INIT_ORG_NAME=Local
LANGFUSE_INIT_PROJECT_ID=agentic-ai-course
LANGFUSE_INIT_PROJECT_NAME=agentic-ai-course
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-local
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGEME
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=CHANGEME

# --- Langfuse in Docker: internal secrets ----------------------------------

NEXTAUTH_SECRET=CHANGEME
SALT=CHANGEME
ENCRYPTION_KEY=CHANGEME
POSTGRES_PASSWORD=CHANGEME
DATABASE_URL=postgresql://postgres:CHANGEME@postgres:5432/postgres
CLICKHOUSE_PASSWORD=CHANGEME
REDIS_AUTH=CHANGEME
MINIO_ROOT_PASSWORD=CHANGEME
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=CHANGEME
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=CHANGEME
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=CHANGEME

# Don't send anonymous usage statistics to Langfuse.
TELEMETRY_ENABLED=false
